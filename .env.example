# Copy this file to .env and fill in your values
# Never commit .env to git

# Postgres with pgvector. Local values match docker-compose.yml.
# On Supabase, DATABASE_URL is the pooled connection and DIRECT_URL is the direct one (used by migrations).
DATABASE_URL=postgresql://ai_food:devpassword123@localhost:5432/ai_food_dev
DIRECT_URL=postgresql://ai_food:devpassword123@localhost:5432/ai_food_dev

# Auth.js secret. Generate with: npx auth secret
AUTH_SECRET=your_auth_secret_here
# Base URL the chat route uses to call its tool endpoints (falls back to VERCEL_URL, then localhost:3000)
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (optional, email/password sign-in works without it)
AUTH_GOOGLE_ID=your_google_client_id_here
AUTH_GOOGLE_SECRET=your_google_client_secret_here

# Claude API for the chat assistant and tool use
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI text-embedding-3-small for semantic meal search
OPENAI_API_KEY=your_openai_api_key_here
